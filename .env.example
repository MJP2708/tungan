# Copy to .env.local and fill in. Never commit the filled-in file.
# Everything here is SERVER-ONLY except NEXT_PUBLIC_LIFF_ID.

# Neon. Route handlers use the POOLED string (the -pooler host); serverless
# functions open many short-lived connections and exhaust a direct one.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/tungan?sslmode=require
# Migrations only.
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/tungan?sslmode=require

# LINE Login channel (same Provider as the Messaging API channel).
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Messaging API channel.
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# Canonical origin. The LINE console needs a stable HTTPS webhook URL at
# <APP_BASE_URL>/api/webhooks/line — never a preview URL that rotates.
APP_BASE_URL=https://app.example.com

# Shared secret for the reminder scheduler. Any cron caller sends it as
# `Authorization: Bearer <value>`; Vercel Cron does this automatically.
CRON_SECRET=

# The ONLY value that may be public.
NEXT_PUBLIC_LIFF_ID=

# Local integration tests only (docker postgres), never a real database.
# TEST_DATABASE_URL=postgres://postgres:test@localhost:55432/tungan_test
