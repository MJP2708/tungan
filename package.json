{
  "name": "tungan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tungan/web",
    "build": "npm run build --workspace @tungan/web",
    "start": "npm run start --workspace @tungan/web",
    "dev:api": "npm run dev --workspace @tungan/api",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  }
}
